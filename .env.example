# PlotWorks environment settings
# Copy this file to .env and fill in the API key for the model provider you use.

# Native Gemini through Google ADK
PROVIDER=gemini
MODEL=gemini-flash-latest
GOOGLE_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Non-Gemini providers route through LiteLLM.
# PROVIDER=litellm
# MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE

# Example: Claude through LiteLLM
# PROVIDER=litellm
# MODEL=anthropic/claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=PASTE_YOUR_ANTHROPIC_API_KEY_HERE

# Optional path overrides. Leave blank/commented for package-relative defaults.
# DATA_DIR=<this package>/data
# OUTPUT_DIR=<this package>/outputs
# PLOT_OUTPUT_DIR=<this package>/outputs/plots
# ANIMATION_OUTPUT_DIR=<this package>/outputs/animations
# DATA_OUTPUT_DIR=<this package>/outputs/data
# TRANSFORMED_DATA_OUTPUT_DIR=<this package>/outputs/data/transformed
# REPORT_OUTPUT_DIR=<this package>/outputs/reports
# CODE_OUTPUT_DIR=<this package>/outputs/code
# GGPLOT2_CASES_DIR=<this package>/r_plot_library/ggplot2_cases
# GGPLOT2_CASES_MANIFEST=<this package>/plot_manifests/ggplot2_cases.json
# R_SHARED_PLOT_DIR=<this package>/r_plot_library/shared

ALLOW_ABSOLUTE_DATA_PATHS=false
MAX_FILE_MB=100
MAX_PREVIEW_ROWS=8
ENABLE_WEB_SEARCH=false

# Generated-code safety limits. Custom Python transformations, custom static R
# plots, and custom R/gganimate plots are available by default. PlotWorks uses
# validation, managed paths, and ADK confirmation for publishing results.
MAX_GENERATED_R_CODE_CHARS=30000
R_PLOT_TIMEOUT_SECONDS=180
MAX_GENERATED_TRANSFORM_CODE_CHARS=30000
DATA_TRANSFORM_TIMEOUT_SECONDS=120
R_ANIMATION_TIMEOUT_SECONDS=300

# Model routing. MODEL above remains the default for every task when it is the
# only model. MODEL also accepts a JSON list; MODELS takes precedence when set.
# For multiple models, explicitly register all candidates in MODELS. These IDs
# are placeholders: replace them with model IDs available to your API accounts.
# Bare IDs use PROVIDER. gemini/<id> selects native ADK Gemini. All other
# provider/model prefixes use LiteLLM; litellm/<provider>/<id> forces LiteLLM.
# MODELS='["gemini/your-fast-model","gemini/your-standard-model","anthropic/your-coding-model","gemini/your-reasoning-model"]'
# MODEL_FAST=gemini/your-fast-model
# MODEL_STANDARD=gemini/your-standard-model
# MODEL_CODING='["anthropic/your-coding-model","gemini/your-reasoning-model"]'
# MODEL_REASONING=gemini/your-reasoning-model
# Unassigned profiles follow MODELS order. Assigned profiles prefer their list,
# then the remaining registered models for availability fallback.
# Specific overrides take precedence: agent > task > profile > global order.
# MODEL_TASK_OVERRIDES='{"python_transformation_code":["anthropic/your-coding-model"]}'
# MODEL_AGENT_OVERRIDES='{"ReportAgent":"gemini/your-fast-model"}'
MODEL_CHECK_CREDENTIALS=true
MODEL_MAX_RETRIES=1
MODEL_RETRY_DELAY_SECONDS=1
MODEL_LOG_CALLS=true

# Named dataset and transformation limits. Bounds may be raised deliberately for
# large datasets. Joins report estimated growth before materializing results.
MAX_BUNDLE_DATASETS=50
MAX_BUNDLE_MEMORY_MB=1024
MAX_TRANSFORM_ROWS=2000000
MAX_TRANSFORM_MEMORY_MB=1024
GENERATED_TRANSFORM_MEMORY_MB=2048
MAX_TRANSFORM_OUTPUT_MB=256

# Installed analytical import roots available to generated transformations.
# Add trusted packages here after installing them; installation is never performed
# during a plotting/transformation run. pd and np are always provided.
TRANSFORM_ALLOWED_IMPORTS=pandas,numpy,math,statistics,re,datetime,collections,itertools,functools,decimal,fractions,json
