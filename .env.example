# Data Analysis Agency environment settings
# Copy this file to .env and fill in the API key for the model provider you use.

# Native Gemini through Google ADK
PROVIDER=gemini
MODEL=gemini-flash-latest
GOOGLE_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Non-Gemini providers route through LiteLLM.
# PROVIDER=litellm
# MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE

# PROVIDER=litellm
# MODEL=anthropic/claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=PASTE_YOUR_ANTHROPIC_API_KEY_HERE

# Optional path overrides. Leave blank/commented for package-relative defaults.
# DATA_DIR=<this package>/data
# OUTPUT_DIR=<this package>/outputs
# PLOT_OUTPUT_DIR=<this package>/outputs/plots
# REPORT_OUTPUT_DIR=<this package>/outputs/reports
# CODE_OUTPUT_DIR=<this package>/outputs/code
# GGPLOT2_CASES_DIR=<this package>/r_plot_library/ggplot2_cases
# GGPLOT2_CASES_MANIFEST=<this package>/plot_manifests/ggplot2_cases.json
# R_SHARED_PLOT_DIR=<this package>/r_plot_library/shared

ALLOW_ABSOLUTE_DATA_PATHS=false
MAX_FILE_MB=100
MAX_PREVIEW_ROWS=8
ENABLE_WEB_SEARCH=false

# Experimental custom R plotting. Keep false until you are comfortable with the
# validation rules and local execution behavior.
ENABLE_CUSTOM_R_PLOTTING=false
MAX_GENERATED_R_CODE_CHARS=30000
R_PLOT_TIMEOUT_SECONDS=180
