figure.dpi: 120
savefig.dpi: 300
savefig.bbox: tight
savefig.facecolor: white
figure.facecolor: white
axes.facecolor: white
axes.edgecolor: 1A1A1A
axes.linewidth: 0.8
axes.grid: True
axes.axisbelow: True
axes.titleweight: bold
axes.titlesize: 14
axes.labelsize: 11
axes.labelcolor: 1A1A1A
xtick.color: 1A1A1A
ytick.color: 1A1A1A
xtick.labelsize: 9
ytick.labelsize: 9
grid.color: D9D9D9
grid.linewidth: 0.55
grid.alpha: 0.65
font.size: 10
font.family: sans-serif
legend.frameon: False
legend.fontsize: 9
lines.linewidth: 1.8
lines.markersize: 5
patch.edgecolor: white
patch.linewidth: 0.7
